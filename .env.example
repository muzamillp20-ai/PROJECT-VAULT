# PROJECT VAULT - Environment Variables
# Copy this file to .env and fill in your values

# ============================================
# FIREBASE AUTHENTICATION (Public client config)
# ============================================
# These values are safe to expose in frontend code.
# They identify your Firebase project but cannot be used to access data.
# Get these from: Firebase Console → Project Settings → General → Your apps

VITE_FIREBASE_API_KEY=your_firebase_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=123456789
VITE_FIREBASE_APP_ID=1:123456789:web:abcdef123456

# ============================================
# EMAIL SERVICE (Backend endpoint)
# ============================================
# URL of your backend endpoint that sends thank-you emails.
# The backend must verify the Firebase ID token before sending.
# Example: VITE_EMAIL_API_URL=https://your-api.com/api/send-login-thank-you

VITE_EMAIL_API_URL=

# ============================================
# SERVER-SIDE SECRETS (NEVER put in frontend)
# ============================================
# These should ONLY be in your backend/serverless function environment.
# NEVER prefix these with VITE_ as that exposes them to the browser.

# RESEND_API_KEY=re_your_resend_api_key_here
# FIREBASE_ADMIN_SDK_PATH=/path/to/service-account.json
